# Login is performed manually in a visible Chromium window.
# No credentials are required as environment variables.
#
# Optional settings:
# MANUAL_LOGIN_TIMEOUT_MS=300000   # how long to wait for manual login (ms)
# AUTH_DIR=playwright/.auth        # where the saved session is stored
# NODE_ENV=development             # run the browser headed for everything
# PROXY_URL=http://...             # optional proxy
